---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<section class="section" id="recognition" aria-labelledby="recognition-title">
  <div class="container">
    <h2 class="section-title" id="recognition-title">Recognition</h2>

    <ul class="rows">
      {
        profile.recognition.map((item) => (
          <li class="row">
            <p class="category">{item.category}</p>
            <div class="text">
              <h3 class="title">{item.title}</h3>
              <p class="detail">{item.detail}</p>
            </div>
            {item.link ? (
              <a class="link" href={item.link} target="_blank" rel="noopener">
                <Icon name="badge-check" size={17} />
                {item.linkLabel ?? 'View'}
              </a>
            ) : (
              <span />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rows {
    margin-top: 40px;
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }

  .category {
    font-size: 15px;
    color: var(--text-muted);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .title {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.3;
  }

  .detail {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }

  .link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 700px) {
    .rows {
      margin-top: 28px;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
      padding: 22px 0;
    }

    .category {
      font-size: 14px;
    }

    .title {
      font-size: 19px;
    }

    .detail {
      font-size: 15px;
    }

    .row > span:empty {
      display: none;
    }

    .link {
      justify-self: start;
    }
  }
</style>
