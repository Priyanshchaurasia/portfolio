---
import { profile } from '../data/profile';

// "9.58" → counts to 9.58 with 2 decimals; "300+" → counts to 300, then adds "+"
const stats = profile.stats.map((stat) => {
  const match = stat.countUp ? /^(\d+(?:\.(\d+))?)(.*)$/.exec(stat.value) : null;
  return {
    ...stat,
    to: match ? Number(match[1]) : null,
    decimals: match?.[2]?.length ?? 0,
    suffix: match?.[3] ?? '',
  };
});
---

<section class="stats-section" aria-label="Highlights">
  <div class="container">
    <dl class="stats">
      {
        stats.map((stat) => (
          <div class="stat">
            <dt class="stat-label">{stat.label}</dt>
            <dd class="stat-value">
              {stat.to !== null ? (
                <span data-count-to={stat.to} data-decimals={stat.decimals} data-suffix={stat.suffix}>
                  {stat.value}
                </span>
              ) : (
                stat.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .stat {
    padding: 32px;
    display: flex;
    flex-direction: column-reverse; /* number on top, label below; the label still reads first */
    justify-content: flex-end;
    gap: 6px;
  }

  .stat:first-child {
    padding-left: 0;
  }

  .stat + .stat {
    border-left: 1px solid var(--line);
  }

  .stat-value {
    margin: 0;
    font-family: var(--heading);
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 15px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* Phones: two by two */
  @media (max-width: 900px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-bottom: 0;
    }

    .stat {
      padding: 22px 0 22px 16px;
      gap: 4px;
      border-bottom: 1px solid var(--line);
    }

    .stat:nth-child(odd) {
      padding: 22px 16px 22px 0;
      border-left: 0;
    }

    .stat-value {
      font-size: 32px;
    }

    .stat-label {
      font-size: 14px;
    }
  }
</style>

<!--
  Count-up for every number marked data-count-to (the photo label and the stats).
  It runs inline, right here, so the numbers reset to zero before they're drawn.
  Each one starts counting once it's on screen; nothing moves if reduced motion is on.
-->
<script is:inline>
  (() => {
    const els = document.querySelectorAll('[data-count-to]');
    if (!els.length || !('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const show = (el, value) => {
      el.textContent = value.toFixed(Number(el.dataset.decimals) || 0) + (el.dataset.suffix || '');
    };

    const run = (el) => {
      const to = parseFloat(el.dataset.countTo);
      const start = performance.now();
      const tick = (now) => {
        const t = Math.min(1, (now - start) / 1120);
        show(el, to * (1 - Math.pow(1 - t, 3)));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    els.forEach((el) => show(el, 0));

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          setTimeout(() => run(entry.target), Math.max(0, 900 - performance.now()));
        });
      },
      { threshold: 0.6 },
    );
    els.forEach((el) => io.observe(el));
  })();
</script>
