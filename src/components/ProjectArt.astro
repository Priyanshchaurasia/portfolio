---
// Illustrations for projects that don't have a screenshot yet.
// Pick one with `visual:` in the project's Markdown file.
interface Props {
  visual: 'safesight' | 'offline-llm' | 'campus-map';
}

const { visual } = Astro.props;
---

{
  visual === 'safesight' && (
    <svg viewBox="0 0 620 440" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Top-down diagram: a machine surrounded by a red stop zone and a yellow warning zone, with a detected person in the warning zone">
      <rect width="620" height="440" fill="#0E1B40" />
      <g transform="translate(-131 40) scale(1.5)">
        <rect x="144" y="28" width="300" height="184" rx="26" fill="#FFC53D" fill-opacity="0.07" stroke="#FFC53D" stroke-width="1.5" stroke-dasharray="6 6" />
        <rect x="214" y="70" width="160" height="100" rx="16" fill="#FF6B5E" fill-opacity="0.12" stroke="#FF6B5E" stroke-width="1.5" />
        <text class="sans" x="160" y="50" fill="#FFC53D" font-size="11">warning zone</text>
        <text class="sans" x="226" y="90" fill="#FF8A80" font-size="11">stop zone</text>
        <rect x="258" y="100" width="76" height="46" rx="6" fill="#22346A" stroke="#7C93DA" stroke-width="1.5" />
        <path d="M334 114 L378 100 L392 122" fill="none" stroke="#7C93DA" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="182" cy="126" r="7" fill="#EEF2FF" />
        <rect x="175" y="135" width="14" height="24" rx="6" fill="#EEF2FF" />
        <path d="M166 122 V112 H176 M188 112 H198 V122 M198 158 V168 H188 M176 168 H166 V158" fill="none" stroke="#FFC53D" stroke-width="2" />
        <rect x="166" y="94" width="84" height="16" rx="3" fill="#FFC53D" />
        <text class="mono" x="171" y="106" fill="#0B1633" font-size="10" font-weight="600">person 0.94</text>
      </g>
    </svg>
  )
}

{
  visual === 'offline-llm' && (
    <svg viewBox="0 0 620 440" preserveAspectRatio="xMidYMid slice" role="img" aria-label="A local terminal showing the offline coding model answering a question about reversing a linked list">
      <rect width="620" height="440" fill="#0E1B40" />
      <g transform="translate(-13 88) scale(1.1)">
        <rect x="48" y="26" width="492" height="188" rx="10" fill="#0A1330" stroke="#26386B" stroke-width="1.5" />
        <line x1="48" x2="540" y1="56" y2="56" stroke="#26386B" stroke-width="1.5" />
        <text class="mono" x="66" y="46" fill="#A7B4D9" font-size="11">coding-model, running locally</text>
        <rect x="440" y="34" width="84" height="16" rx="8" fill="none" stroke="#FFC53D" stroke-width="1.2" />
        <circle cx="453" cy="42" r="3" fill="#FFC53D" />
        <text class="mono" x="462" y="46" fill="#FFC53D" font-size="10">offline</text>
        <text class="mono" x="66" y="84" fill="#EEF2FF" font-size="12">&gt; reverse a linked list in python</text>
        <text class="mono" x="66" y="112" fill="#FFC53D" font-size="12">def reverse(head):</text>
        <text class="mono" x="90" y="131" fill="#A7B4D9" font-size="12">prev = None</text>
        <text class="mono" x="90" y="150" fill="#A7B4D9" font-size="12">while head:</text>
        <text class="mono" x="114" y="169" fill="#A7B4D9" font-size="12">head.next, prev, head = prev, head, head.next</text>
        <text class="mono" x="90" y="188" fill="#A7B4D9" font-size="12">return prev</text>
      </g>
    </svg>
  )
}

{
  visual === 'campus-map' && (
    <svg viewBox="0 0 620 440" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Stylised campus map with buildings, roads and a dashed route from the current position to a destination pin">
      <rect width="620" height="440" fill="#0E1B40" />
      <path d="M40 220 H580 M250 40 V400 M455 220 V400" fill="none" stroke="#1C2C5E" stroke-width="18" stroke-linecap="round" />
      <rect x="80" y="70" width="130" height="100" rx="10" fill="#172756" stroke="#2A3E7A" stroke-width="1.5" />
      <rect x="295" y="60" width="130" height="115" rx="10" fill="#172756" stroke="#2A3E7A" stroke-width="1.5" />
      <rect x="470" y="80" width="100" height="95" rx="10" fill="#172756" stroke="#2A3E7A" stroke-width="1.5" />
      <rect x="80" y="270" width="130" height="110" rx="10" fill="#172756" stroke="#2A3E7A" stroke-width="1.5" />
      <rect x="295" y="265" width="120" height="115" rx="10" fill="#172756" stroke="#2A3E7A" stroke-width="1.5" />
      <rect x="495" y="265" width="80" height="115" rx="10" fill="#172756" stroke="#2A3E7A" stroke-width="1.5" />
      <path d="M130 220 H455 V300" fill="none" stroke="#FFC53D" stroke-width="4" stroke-dasharray="10 8" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="130" cy="220" r="18" fill="#EEF2FF" fill-opacity="0.15" />
      <circle cx="130" cy="220" r="9" fill="#EEF2FF" />
      <text class="sans" x="96" y="196" fill="#EEF2FF" font-size="15">you are here</text>
      <path d="M455 322 C446 309 438 300 438 290 A17 17 0 0 1 472 290 C472 300 464 309 455 322 Z" fill="#FFC53D" />
      <circle cx="455" cy="290" r="6" fill="#0B1633" />
    </svg>
  )
}

<style>
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .sans {
    font-family: var(--body);
  }

  .mono {
    font-family: var(--mono);
  }
</style>
