---
// The resume preview. Any link marked data-resume-open opens this panel instead
// of starting a download; Download and Open in new tab live inside it.
// Without JavaScript those links simply open the PDF in a new tab.
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const { resume, name } = profile;
const fileName = `${name.replace(/\s+/g, '_')}_Resume.pdf`;
---

<dialog class="resume-dialog" id="resume-dialog" aria-labelledby="resume-dialog-title">
  <div class="panel">
    <header class="bar">
      <h2 class="title" id="resume-dialog-title">Resume</h2>

      <div class="bar-actions">
        <a class="btn btn-small btn-outline open-tab" href={resume} target="_blank" rel="noopener">
          <Icon name="external" size={16} />
          Open in new tab
        </a>
        <a class="btn btn-small btn-accent-outline" href={resume} download={fileName}>
          <Icon name="download" size={16} />
          Download
        </a>
        <button class="close" type="button" aria-label="Close resume">
          <Icon name="close" size={22} />
        </button>
      </div>
    </header>

    <div class="body">
      <!-- src is set on first open, so the PDF is not fetched until it is wanted -->
      <iframe class="frame" title={`${name} resume`} data-src={`${resume}#view=FitH`}></iframe>

      <!-- Phones and tablets: most mobile browsers cannot show a PDF inline -->
      <div class="fallback">
        <Icon name="file-text" size={40} strokeWidth={1.4} />
        <p>Your browser can’t preview PDFs inline. Open the resume in a new tab, or download it.</p>
        <div class="fallback-actions">
          <a class="btn btn-primary" href={resume} target="_blank" rel="noopener">
            <Icon name="external" size={18} />
            Open resume
          </a>
          <a class="btn btn-outline" href={resume} download={fileName}>
            <Icon name="download" size={18} />
            Download
          </a>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  .resume-dialog {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(12px, 3vw, 40px);
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .resume-dialog::backdrop {
    background: rgba(2, 4, 9, 0.74);
    backdrop-filter: blur(3px);
  }

  .panel {
    width: min(100%, 1040px);
    height: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line-card);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 30px 70px rgba(2, 4, 9, 0.6);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }

  .title {
    font-family: var(--heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
  }

  .bar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .close:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }

  .body {
    flex: 1;
    min-height: 0;
    background: #11182e;
  }

  .frame {
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* The fallback replaces the frame where inline PDFs don't work */
  .fallback {
    display: none;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 28px;
    text-align: center;
    color: var(--text-muted);
  }

  .fallback p {
    max-width: 34ch;
    font-size: 16px;
    line-height: 1.6;
  }

  .fallback-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  /* ─── Phones and small tablets ─── */
  @media (max-width: 760px) {
    .frame {
      display: none;
    }

    .fallback {
      display: flex;
    }

    /* Only the close button stays in the bar; the rest sit in the fallback */
    .bar-actions .btn {
      display: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#resume-dialog');
  const frame = dialog?.querySelector<HTMLIFrameElement>('.frame');
  const triggers = document.querySelectorAll<HTMLAnchorElement>('[data-resume-open]');

  if (dialog && typeof dialog.showModal === 'function') {
    const open = (event: MouseEvent) => {
      // Let modifier-clicks and middle-clicks open the PDF in a tab as usual
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (frame && !frame.src && frame.dataset.src) frame.src = frame.dataset.src;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    };

    triggers.forEach((trigger) => trigger.addEventListener('click', open));

    dialog.querySelector<HTMLButtonElement>('.close')?.addEventListener('click', () => dialog.close());

    // Clicking the dark area outside the panel closes it
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Escape closes it natively; this puts the page scroll back
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });
  }
</script>
