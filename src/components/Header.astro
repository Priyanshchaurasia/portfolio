---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const links = [
  { label: 'Work', href: '#work' },
  { label: 'Experience', href: '#experience' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="site-header" data-menu="closed">
  <div class="container header-inner">
    <a class="wordmark" href="#top">
      <span class="name">{profile.name}</span>
      {profile.role && <span class="role">{profile.role}</span>}
    </a>

    <nav aria-label="Main">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu" aria-label="Open menu">
        <span class="icon-open"><Icon name="menu" size={24} /></span>
        <span class="icon-close"><Icon name="close" size={24} /></span>
      </button>

      <ul class="nav-list" id="main-menu">
        {
          links.map((link) => (
            <li>
              <a class="nav-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="nav-resume">
          <a
            class="btn btn-small btn-accent-outline"
            href={profile.resume}
            target="_blank"
            rel="noopener"
            data-resume-open
          >
            <Icon name="file-text" size={18} />
            Resume
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    border-bottom: 1px solid var(--line-header);
  }

  .header-inner {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    color: var(--text);
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--text);
  }

  .name {
    font-family: var(--heading);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* The job title, after a thin divider */
  .role {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .role::before {
    content: '|';
    margin: 0 10px;
    color: var(--line-strong);
    font-weight: 400;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-size: 16px;
    font-weight: 500;
  }

  .nav-link:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .menu-toggle {
    display: none;
  }

  /* Too tight next to the menu button on phones */
  @media (max-width: 620px) {
    .role {
      display: none;
    }
  }

  /* ─── Phones and small tablets ─── */
  @media (max-width: 900px) {
    .header-inner {
      height: 64px;
    }

    .name {
      font-size: 19px;
    }

    .role {
      font-size: 14px;
    }

    .role::before {
      margin: 0 8px;
    }

    /* Without JavaScript, the links simply stay visible. With it, they fold into the menu. */
    :global(.js) .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--text);
      cursor: pointer;
    }

    .icon-close,
    [data-menu='open'] .icon-open {
      display: none;
    }

    [data-menu='open'] .icon-close {
      display: block;
    }

    :global(.js) .nav-list {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 24px;
      background: var(--bg-top);
      border-bottom: 1px solid var(--line-header);
      box-shadow: 0 24px 40px rgba(2, 4, 9, 0.6);
    }

    :global(.js) [data-menu='open'] .nav-list {
      display: flex;
    }

    :global(.js) .nav-link {
      width: 100%;
      min-height: 52px;
      font-size: 18px;
      border-bottom: 1px solid var(--line);
    }

    :global(.js) .nav-resume {
      margin-top: 20px;
    }

    :global(.js) .nav-resume .btn {
      width: 100%;
      height: 52px;
    }

    /* No-JavaScript fallback: links wrap into a row */
    :global(html:not(.js)) .header-inner {
      height: auto;
      padding: 16px 0;
      flex-wrap: wrap;
    }

    :global(html:not(.js)) .nav-list {
      flex-wrap: wrap;
      gap: 8px 24px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.dataset.menu = open ? 'open' : 'closed';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    toggle.addEventListener('click', () => setOpen(header.dataset.menu !== 'open'));

    // Close after choosing a link, pressing Escape, or tapping outside the menu
    header.querySelectorAll('.nav-list a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.dataset.menu === 'open') {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (header.dataset.menu === 'open' && !header.contains(event.target as Node)) setOpen(false);
    });

    // Reset if the window is widened back to desktop
    window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
