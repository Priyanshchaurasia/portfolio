---
// A 3D network of nodes behind the whole page, with amber signals travelling
// along the links. It stays in place while you scroll, sways gently, and leans
// toward the mouse on desktop. Fewer nodes on phones; a still frame for
// visitors who prefer reduced motion; paused while the tab is hidden.
---

<canvas class="neural-bg" aria-hidden="true"></canvas>

<style>
  .neural-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.neural-bg');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    // ─── Settings you can tweak ───
    const DENSITY = 1 / 11000; // nodes per pixel of screen area (higher = denser)
    const MAX_NODES = 150;
    const MIN_NODES = 48;
    const LINK_DISTANCE = 0.5; // how close two nodes must be to connect
    const LINK_BRIGHTNESS = 0.38; // 0 to 1
    const NODE_BRIGHTNESS = 0.7; // 0 to 1
    const SWAY = 0.35; // how far the network turns back and forth
    const MOUSE_SENSITIVITY = 0.25; // how much it leans toward the mouse (0 = not at all, 1 = a lot)
    const CYAN = '125, 249, 255';
    const AMBER = '255, 197, 61';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const dpr = Math.min(2, window.devicePixelRatio || 1);

    type Vec = [number, number, number];
    type Node = { p: Vec; v: Vec };
    let nodes: Node[] = [];
    const pulses: { a: number; b: number; s: number }[] = [];

    const makeNodes = (count: number) => {
      nodes = Array.from({ length: count }, () => ({
        p: [(Math.random() - 0.5) * 2.4, (Math.random() - 0.5) * 2.4, (Math.random() - 0.5) * 2.4] as Vec,
        v: [(Math.random() - 0.5) * 0.0018, (Math.random() - 0.5) * 0.0018, (Math.random() - 0.5) * 0.0018] as Vec,
      }));
      pulses.length = 0;
    };

    let width = 0;
    let height = 0;
    const resize = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(MAX_NODES, Math.max(MIN_NODES, width * height * DENSITY)));
      if (count !== nodes.length) makeNodes(count);
      if (reduceMotion) draw(0);
    };

    // Mouse lean, eased so it glides rather than snaps
    let mouseX = 0;
    let mouseY = 0;
    let leanX = 0;
    let leanY = 0;
    if (finePointer && !reduceMotion) {
      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX / window.innerWidth - 0.5;
        mouseY = e.clientY / window.innerHeight - 0.5;
      });
    }

    const rotate = ([x, y, z]: Vec, ax: number, ay: number): Vec => {
      let c = Math.cos(ay);
      let s = Math.sin(ay);
      [x, z] = [x * c - z * s, x * s + z * c];
      c = Math.cos(ax);
      s = Math.sin(ax);
      [y, z] = [y * c - z * s, y * s + z * c];
      return [x, y, z];
    };

    function draw(time: number) {
      ctx!.clearRect(0, 0, width, height);
      leanX += (mouseX - leanX) * 0.03;
      leanY += (mouseY - leanY) * 0.03;

      const angleY = Math.sin(time * 0.00011) * SWAY + leanX * 0.7 * MOUSE_SENSITIVITY;
      const angleX = Math.cos(time * 0.00008) * SWAY * 0.4 + leanY * 0.45 * MOUSE_SENSITIVITY;
      const cx = width / 2;
      const cy = height / 2;
      const sx = width * 0.5;
      const sy = height * 0.55;

      if (!reduceMotion) {
        for (const n of nodes) {
          for (let i = 0; i < 3; i++) {
            n.p[i] += n.v[i];
            if (Math.abs(n.p[i]) > 1.2) n.v[i] *= -1;
          }
        }
      }

      const points = nodes.map((n) => {
        const r = rotate(n.p, angleX, angleY);
        const k = 3 / (3 + r[2]);
        return [cx + r[0] * sx * k, cy + r[1] * sy * k, k] as Vec;
      });

      // Links
      ctx!.lineWidth = 0.8;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i].p;
          const b = nodes[j].p;
          const d = Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);
          if (d < LINK_DISTANCE) {
            ctx!.strokeStyle = `rgba(${CYAN}, ${((1 - d / LINK_DISTANCE) * LINK_BRIGHTNESS).toFixed(3)})`;
            ctx!.beginPath();
            ctx!.moveTo(points[i][0], points[i][1]);
            ctx!.lineTo(points[j][0], points[j][1]);
            ctx!.stroke();
            if (!reduceMotion && pulses.length < 18 && Math.random() < 0.0012) pulses.push({ a: i, b: j, s: 0 });
          }
        }
      }

      // Amber signals travelling along links
      for (let k = pulses.length - 1; k >= 0; k--) {
        const pulse = pulses[k];
        pulse.s += 0.016;
        if (pulse.s > 1) {
          pulses.splice(k, 1);
          continue;
        }
        const A = points[pulse.a];
        const B = points[pulse.b];
        ctx!.fillStyle = `rgba(${AMBER}, 0.8)`;
        ctx!.beginPath();
        ctx!.arc(A[0] + (B[0] - A[0]) * pulse.s, A[1] + (B[1] - A[1]) * pulse.s, 2.4, 0, Math.PI * 2);
        ctx!.fill();
      }

      // Nodes, brighter and bigger when closer
      for (const p of points) {
        ctx!.fillStyle = `rgba(${CYAN}, ${Math.min(NODE_BRIGHTNESS, 0.25 + 0.45 * p[2]).toFixed(3)})`;
        ctx!.beginPath();
        ctx!.arc(p[0], p[1], 2.1 * p[2], 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    // Animate while the tab is visible
    let running = false;
    let frame = 0;
    const loop = (time: number) => {
      draw(time);
      frame = requestAnimationFrame(loop);
    };
    const update = () => {
      const shouldRun = !document.hidden && !reduceMotion;
      if (shouldRun && !running) {
        running = true;
        frame = requestAnimationFrame(loop);
      } else if (!shouldRun && running) {
        running = false;
        cancelAnimationFrame(frame);
      }
    };

    window.addEventListener('resize', resize);
    resize();
    document.addEventListener('visibilitychange', update);
    update();
  }
</script>
